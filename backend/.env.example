# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5441/lgu_payroll

# JWT (required)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Config encryption (optional, falls back to JWT_SECRET)
CONFIG_ENCRYPTION_KEY=

# Server
PORT=4101
NODE_ENV=development
WEB_ORIGIN=http://localhost:5175

# Proxy (for webhook IP allowlist behind nginx)
TRUST_PROXY=1

# Migration
RUN_MIGRATIONS_ON_STARTUP=false